+GORILA_SALTO_A_CADA       = (3, 2, 2)   # arremessos entre saltos, por fase
+GORILA_SALTO_DIST_PLAYER  = 4           # tiles mínimos entre o pouso e o jogador
+# Chuva de bananas (fase 3): cachos caem do alto com a sombra marcando o
