+    def __init__(self, dono, x, chao_y, tipo):
+        self.dono = dono
+        tam = int(constants.GORILA_PROJETIL_SIZE * 1.15)
+        self.image = carregar_imagem("itens", ARQUIVOS_MINERIO[tipo], (tam, tam))
