+GORILA_CHUVA_AVISO_MS     = 700
+GORILA_CHUVA_INTERVALO    = 6500
+GORILA_CHUVA_ESPACO_TILES = 3
+GORILA_CHUVA_ATRASO_MS    = 140         # entre um cacho e o próximo
+GORILA_CHUVA_DANO         = 10
