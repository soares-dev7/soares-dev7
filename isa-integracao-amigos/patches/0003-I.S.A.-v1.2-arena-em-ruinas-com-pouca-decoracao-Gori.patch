+        passo = 190 if fundo else 150
+        x = passo // 2
+        while x < largura - passo // 2:
+            pygame.draw.line(
+                surf, cor, (x, altura * 0.25), (x, altura * (0.68 if fundo else 0.86)), 11
+            )
